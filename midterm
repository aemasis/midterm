<body>
  <header>
    <div class="logo">Friends of Palo Alto Library</div>

    <nav class="nav-links">
      <a href="#about">About</a>
      <a href="#sale-rooms">Sale Rooms</a>
      <a href="#calendar">Calendar</a>
